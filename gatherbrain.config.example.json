{
  "defaultFactType": "fact",
  "searchShortcuts": {
    "current": "(type:task OR type:inprogress OR type:waiting) AND (due<=today OR NOT due:*)",
    "overdue": "due<today",
    "today": "due:today"
  },
  "selectionActions": {
    "actions": {
      "idea": {
        "action": "set_type",
        "value": "idea"
      },
      "task": {
        "action": "set_type",
        "value": "task"
      },
      "waiting": {
        "action": "set_type",
        "value": "waiting"
      },
      "inprogress": {
        "action": "set_type",
        "value": "inprogress"
      },
      "abandoned": {
        "action": "set_type",
        "value": "abandoned"
      },
      "done": {
        "action": "set_type",
        "value": "done"
      },
      "today": {
        "action": "set_due",
        "value": "today"
      },
      "tomorrow": {
        "action": "set_due",
        "value": "tomorrow"
      },
      "delete": {
        "action": "trash"
      },
      "gather": {
        "action": "associate_current_context"
      },
      "claim": {
        "action": "claim_current_context"
      },
      "open": {
        "action": "open_file"
      },
      "edit": {
        "action": "edit_file"
      }
    }
  }
}
